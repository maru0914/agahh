parameters:
	ignoreErrors:
		-
			message: '#^Method App\\Actions\\GenerateDiaryCalendarDates\:\:handle\(\) return type with generic class Illuminate\\Support\\Collection does not specify its types\: TKey, TValue$#'
			identifier: missingType.generics
			count: 1
			path: app/Actions/GenerateDiaryCalendarDates.php

		-
			message: '#^Property App\\Actions\\GenerateDiaryCalendarDates\:\:\$diaryCalendarDates with generic class Illuminate\\Support\\Collection does not specify its types\: TKey, TValue$#'
			identifier: missingType.generics
			count: 1
			path: app/Actions/GenerateDiaryCalendarDates.php

		-
			message: '#^Method App\\Http\\Controllers\\Api\\ChatController\:\:__invoke\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: app/Http/Controllers/Api/ChatController.php

        # メール確認機能は未実装。User は MustVerifyEmail を実装していない
        # Verified イベントに渡す型が合わない。このコントローラとルート
        # （routes/auth.php の verification.verify）は Breezeの雛形が残っているだけ。
        # 型のために User へ implements MustVerifyEmail を付けると、新規登録確認メールが送られ、dashboard の verifiedミドルウェアも有効になるため戻した。
        # メール配信を実装するときに、インターフェースを付けて解消する。
        # 2026-09-23
		-
			message: '#^Parameter \#1 \$user of class Illuminate\\Auth\\Events\\Verified constructor expects Illuminate\\Contracts\\Auth\\MustVerifyEmail, App\\Models\\User\|null given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/Auth/VerifyEmailController.php

		-
			message: '#^Method App\\Http\\Controllers\\DiaryCommentController\:\:store\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: app/Http/Controllers/DiaryCommentController.php

